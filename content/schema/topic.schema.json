{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantprep.me/schema/topic.schema.json",
  "title": "QuantPrep Topic manifest",
  "description": "topic.yaml — metadata for a topic folder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "order", "description"],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "probability",
        "statistics",
        "machine-learning",
        "portfolio-construction",
        "quantitative-research",
        "sql"
      ]
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name."
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "description": "Display order / suggested priority."
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "weight": {
      "type": ["number", "null"],
      "description": "Suggested preparation weight (0-1), for the dashboard.",
      "minimum": 0,
      "maximum": 1
    },
    "subtopics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string" }
        }
      }
    }
  }
}
