{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantprep.ai/schema/lesson.schema.json",
  "title": "QuantPrep Lesson front-matter",
  "description": "YAML front-matter of a theory lesson (.mdx). Body is Markdown/MDX + LaTeX.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "topic", "order"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "topic": {
      "type": "string",
      "enum": [
        "probability",
        "statistics",
        "machine-learning",
        "portfolio-construction",
        "research-methodology",
        "sql"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
