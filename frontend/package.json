{
  "name": "quantprep-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "biome check --write src scripts",
    "format:check": "biome format src scripts",
    "lint": "biome check src scripts",
    "typecheck": "tsc --noEmit",
    "validate:math": "node scripts/validate-content-math.mjs",
    "format:math": "node scripts/validate-content-math.mjs --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.62.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "remark-parse": "^11.0.0",
    "typescript": "^5.6.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "yaml": "^2.9.0"
  }
}
